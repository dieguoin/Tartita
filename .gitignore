# ==========================================
# Unity Project .gitignore
# ==========================================

# Unity Folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# Unity Crash & Recovery
sysinfo.txt
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Burst Debug Symbols
*_BurstDebugInformation_DoNotShip/

# Mobile Builds & Artifacts
*.apk
*.aab
*.obb
*.xapk
*.unitypackage
*.unitypackage.meta
*.app

# Android Security & Signing Keys (CRITICAL)
*.keystore
*.jks
*.p12
*.cer
*.key
google-services.json
GoogleService-Info.plist

# Gradle & Android Resolver
.gradle/
crashlytics-build.properties

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Meta Files autogenerated for deleted caches
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Scratch / Agent temporary scripts
scratch/

# OS Generated
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
